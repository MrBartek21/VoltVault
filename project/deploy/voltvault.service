[Unit]
Description=VoltVault inventory panel
After=network.target local-fs.target
Wants=network.target

[Service]
Type=simple
User=ndn02
Group=ndn02
WorkingDirectory=/home/ndn02/VoltVault
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ndn02/VoltVault/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
