[Unit]
Description=VoltVault inventory panel
After=network.target local-fs.target
Wants=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/VoltVault
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/VoltVault/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
